# ── GitHub Source (REQUIRED) ──────────────────────────────────────────────────
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Concurrency (optional, defaults shown) ───────────────────────────────────
REPO_CONCURRENCY=3
FILE_CONCURRENCY=10

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Get: Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=abc123def456
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=my-github-backup

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# IAM user needs s3:PutObject on the bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET=my-github-backup

# ── Google Drive (service account) ───────────────────────────────────────────
# Get: GCP Console → IAM → Service Accounts → Create → download JSON key
# Share a Drive folder with the service account email, copy folder ID from URL
GDRIVE_CLIENT_EMAIL=backup@myproject.iam.gserviceaccount.com
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GDRIVE_ROOT_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── GitHub Target Repo ────────────────────────────────────────────────────────
# Target repo must exist; GITHUB_PAT must have write access to it
GITHUB_TARGET_OWNER=myorg
GITHUB_TARGET_REPO=github-backup-store
GITHUB_TARGET_BRANCH=main

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Get: Azure Portal → Storage Account → Access keys → Connection string
# Container is created automatically if it doesn't exist
AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net"
AZURE_CONTAINER=github-backup

# ── Web / Vercel (cron webhook) ───────────────────────────────────────────────
# CRON_SECRET: any random string — sent by cronjobs.org as x-cron-secret header
CRON_SECRET=change-me-to-a-random-secret
CRON_SKIP_FORKS=true
CRON_SKIP_ARCHIVED=false
CRON_VISIBILITY=all
CRON_DRY_RUN=false
CRON_MATCH=
CRON_TOPICS=
CRON_MAX_FILE_SIZE=
CRON_REPO_CONCURRENCY=3
CRON_FILE_CONCURRENCY=10
CRON_METADATA=false
CRON_METADATA_TYPES=

# ── Durable run state (S3-compatible storage; Redis is not required) ─────────
RUN_STORE_KEY_PREFIX=detiq
RUN_QUEUE_ENCRYPTION_KEY=change-me-to-a-long-random-value
