# GitHub source (required)
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# Concurrency limits
REPO_CONCURRENCY=3       # parallel repos at a time
FILE_CONCURRENCY=10      # parallel file downloads per repo

# --- Storage Adapters ---
# Only adapters with all required vars set will be enabled

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AWS S3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Google Drive (service account)
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=
GDRIVE_ROOT_FOLDER_ID=

# GitHub target repo
GITHUB_TARGET_OWNER=
GITHUB_TARGET_REPO=
GITHUB_TARGET_BRANCH=main

# Azure Blob Storage
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=
